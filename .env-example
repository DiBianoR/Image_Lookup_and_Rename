# API Keys Required for the Pipeline
GOOGLE_API_KEY=your_google_api_key_here

# Local directory where your images are stored
DIRECTORY_PATH=your_image_directory_here

# The public-facing URL that SerpApi will use to access the images
BASE_URL=your_image_directory_url_here

# Choose your image search backend: 'serpapi', 'vision', or 'playwright'
IMAGE_BACKEND=serpapi

# If using 'serpapi', you MUST provide a SerpAPI key
SERPAPI_KEY=your_serpapi_key_here

# If using 'vision', you MUST provide the path to your Google Cloud Service Account JSON key
GOOGLE_APPLICATION_CREDENTIALS=path/to/your/service-account-file.json

# If using 'playwright', Set to False to watch the browser run
PLAYWRIGHT_HEADLESS=False

# Allow the script to trigger a second LLM pass on failure (set to False to save money on bulk runs)
ENABLE_PASS_2=False